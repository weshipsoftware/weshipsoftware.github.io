{
  "actions" : {
    "build" : {
      "enabled" : true,
      "script" : "mix deps.get\nmix compile"
    },
    "clean" : {
      "enabled" : true,
      "script" : "rm -rf _build .elixir_ls deps"
    },
    "run" : {
      "enabled" : true,
      "script" : "mix run --no-halt"
    }
  },
  "openLogOnRun" : "fail"
}
